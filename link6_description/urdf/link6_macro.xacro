<?xml version="1.0" encoding="utf-8"?>
<robot name="link6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="link6" params="
    parent
    *origin
    prefix:=''
    robot_ip
    username:=admin
    password:=admin
    port=1883
    port_realtime=10001
    session_inactivity_timeout_ms=60000
    connection_inactivity_timeout_ms=2000
    use_internal_bus_gripper_comm:=false
    gripper
    gripper_joint_name:=''
    gripper_b_joint_name:=''
    gripper_modbus_id:=9
    gripper_b_modbus_id:=10
    use_fake_hardware:=false
    mock_sensor_commands:=false
    sim_gazebo:=false
    low_level_mode:=false
    safety_mode:=reduced
    initial_positions_file:='$(find link6_description)/config/initial_positions.yaml'
    calibration_file:='$(find link6_description)/config/default_calibration.yaml'">

    <!-- Load initial positions from yaml file -->
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)}" />

    <!-- Load calibration data from YAML file -->
    <xacro:property name="calib" value="${xacro.load_yaml(calibration_file)}" />

    <!-- Define joint origin properties from calibration data -->
    <xacro:property name="joint_1_xyz" value="${calib['joint_1']['xyz']}" />
    <xacro:property name="joint_1_rpy" value="${calib['joint_1']['rpy']}" />

    <xacro:property name="joint_2_xyz" value="${calib['joint_2']['xyz']}" />
    <xacro:property name="joint_2_rpy" value="${calib['joint_2']['rpy']}" />

    <xacro:property name="joint_3_xyz" value="${calib['joint_3']['xyz']}" />
    <xacro:property name="joint_3_rpy" value="${calib['joint_3']['rpy']}" />

    <xacro:property name="joint_4_xyz" value="${calib['joint_4']['xyz']}" />
    <xacro:property name="joint_4_rpy" value="${calib['joint_4']['rpy']}" />

    <xacro:property name="joint_5_xyz" value="${calib['joint_5']['xyz']}" />
    <xacro:property name="joint_5_rpy" value="${calib['joint_5']['rpy']}" />

    <xacro:property name="joint_6_xyz" value="${calib['joint_6']['xyz']}" />
    <xacro:property name="joint_6_rpy" value="${calib['joint_6']['rpy']}" />

    <!-- Other properties -->
    <xacro:property name="base_collision_radius" value="0.08"/>
    <xacro:property name="shoulder_collision_radius" value="0.07"/>
    <xacro:property name="arm_collision_radius" value="0.06"/>
    <xacro:property name="forearm_collision_radius" value="0.055"/>
    <xacro:property name="lower_wrist_collision_radius" value="0.05"/>
    <xacro:property name="upper_wrist_collision_radius" value="0.05"/>
    <xacro:property name="wrist_interface_collision_radius" value="0.05"/>


    <!-- ros2 control include -->
    <xacro:include filename="$(find link6_description)/urdf/link6.ros2_control.xacro" />
    <xacro:link6_ros2_control
      prefix="${prefix}"
      robot_ip="${robot_ip}"
      username="${username}"
      password="${password}"
      port="${port}"
      port_realtime="${port_realtime}"
      session_inactivity_timeout_ms="${session_inactivity_timeout_ms}"
      connection_inactivity_timeout_ms="${connection_inactivity_timeout_ms}"
      use_internal_bus_gripper_comm="${use_internal_bus_gripper_comm}"
      gripper="${gripper}"
      gripper_joint_name="${gripper_joint_name}"
      gripper_b_joint_name="${gripper_b_joint_name}"
      gripper_modbus_id="${gripper_modbus_id}"
      gripper_b_modbus_id="${gripper_b_modbus_id}"
      use_fake_hardware="${use_fake_hardware}"
      mock_sensor_commands="${mock_sensor_commands}"
      sim_gazebo="${sim_gazebo}"
      low_level_mode="${low_level_mode}"
      safety_mode="${safety_mode}"
      initial_positions="${initial_positions}" />


    <!-- Define material colors -->
    <material name="lightgray">
      <color rgba="0.5294117647058824 0.5294117647058824 0.5294117647058824 1" />
    </material>
    <material name="darkgray">
      <color rgba="0.19607843137254902 0.19607843137254902 0.19607843137254902 1" />
    </material>
    <material name="kinovablue">
      <color rgba="0.0 0.0784313725490196 0.5372549019607843 1" />
    </material>


    <!-- Link6 URDF starts here -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}base_link" />
    </joint>

    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.00721418 -0.00010978 0.03709101" rpy="0 0 0" />
        <mass value="1.86878181" />
        <inertia ixx="0.00333792" ixy="3.22E-06" ixz="0.00024559"
          iyy="0.0046469" iyz="3.88E-06" izz="0.00539116" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find link6_description)/meshes/base_link.STL" />
        </geometry>
        <material name="lightgray" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${base_collision_radius}" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}shoulder_link">
      <inertial>
        <origin xyz="0.03930119 -0.00705889 -0.08462154" rpy="0 0 0" />
        <mass value="4.8256987" />
        <inertia ixx="0.0192746" ixy="-0.00239802" ixz="-0.00896331"
          iyy="0.03087806" iyz="0.0016298" izz="0.02134949" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find link6_description)/meshes/shoulder_link.STL" />
        </geometry>
        <material name="lightgray" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.04" rpy="0 0 0" />
        <geometry>
          <sphere radius="${shoulder_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.06065737 -0.01 -0.08144986" rpy="0 0 0" />
        <geometry>
          <sphere radius="${shoulder_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 -0.11" rpy="0 0 0" />
        <geometry>
          <sphere radius="${shoulder_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.1078564 -0.02138667 -0.1392602" rpy="0 0 0" />
        <geometry>
          <sphere radius="${shoulder_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.04343076 -0.003456797 -0.1306261" rpy="0 0 0" />
        <geometry>
          <sphere radius="${shoulder_collision_radius}" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_1" type="revolute">
      <origin xyz="${joint_1_xyz}" rpy="${joint_1_rpy}" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}shoulder_link" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="210"
        velocity="3.141592653589793" />
    </joint>
    <link name="${prefix}arm_link">
      <inertial>
        <origin xyz="2.53E-06 0.18829586 -0.03988382" rpy="0 0 0" />
        <mass value="5.98601487" />
        <inertia ixx="0.25899206" ixy="-2.89E-05" ixz="-1.23E-06"
          iyy="0.01755445" iyz="-0.02128064" izz="0.25291674" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find link6_description)/meshes/arm_link.STL" />
        </geometry>
        <material name="lightgray" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.01524985" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.003107564 -0.05411892" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.04674223 -0.07957917" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.1114492 -0.07957917" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.179992  -0.07957917" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.2487042 -0.07957917" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.3173259 -0.07957917" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.3835145 -0.07957917" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.4415521 -0.07957917" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.4824647 -0.05411892" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.4848319 -0.01524985" rpy="0 0 0" />
        <geometry>
          <sphere radius="${arm_collision_radius}" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_2" type="revolute">
      <origin xyz="${joint_2_xyz}" rpy="${joint_2_rpy}" />
      <parent link="${prefix}shoulder_link" />
      <child link="${prefix}arm_link" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="210"
        velocity="3.141592653589793" />
    </joint>
    <link name="${prefix}forearm_link">
      <inertial>
        <origin xyz="4.64E-06 -0.02451414 -0.02997969" rpy="0 0 0" />
        <mass value="3.41588342" />
        <inertia ixx="0.01742043" ixy="-3.55E-06" ixz="8.4E-07"
          iyy="0.01119175" iyz="0.00518163" izz="0.01212876" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find link6_description)/meshes/forearm_link.STL" />
        </geometry>
        <material name="lightgray" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.01478543" rpy="0 0 0" />
        <geometry>
          <sphere radius="${forearm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.002774531 -0.05402248" rpy="0 0 0" />
        <geometry>
          <sphere radius="${forearm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.02792384  -0.08310601" rpy="0 0 0" />
        <geometry>
          <sphere radius="${forearm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.07494865 -0.09085903" rpy="0 0 0" />
        <geometry>
          <sphere radius="${forearm_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.1212274  -0.091767" rpy="0 0 0" />
        <geometry>
          <sphere radius="${forearm_collision_radius}" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_3" type="revolute">
      <origin xyz="${joint_3_xyz}" rpy="${joint_3_rpy}" />
      <parent link="${prefix}arm_link" />
      <child link="${prefix}forearm_link" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="210"
        velocity="3.141592653589793" />
    </joint>
    <link name="${prefix}lower_wrist_link">
      <inertial>
        <origin xyz="-0.00010793 -0.01056422 -0.08091102" rpy="0 0 0" />
        <mass value="2.08494922" />
        <inertia ixx="0.02454276" ixy="2.61E-06" ixz="1.799E-05"
          iyy="0.02385702" iyz="0.00315758" izz="0.00294903" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find link6_description)/meshes/lower_wrist_link.STL" />
        </geometry>
        <material name="darkgray" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.01025881" rpy="0 0 0" />
        <geometry>
          <sphere radius="${lower_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 -0.06014508" rpy="0 0 0" />
        <geometry>
          <sphere radius="${lower_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 -0.1106502" rpy="0 0 0" />
        <geometry>
          <sphere radius="${lower_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 -0.1607216" rpy="0 0 0" />
        <geometry>
          <sphere radius="${lower_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.001607588 -0.2100781" rpy="0 0 0" />
        <geometry>
          <sphere radius="${lower_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.03559661 -0.222183" rpy="0 0 0" />
        <geometry>
          <sphere radius="${lower_wrist_collision_radius}" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_4" type="revolute">
      <origin xyz="${joint_4_xyz}" rpy="${joint_4_rpy}" />
      <parent link="${prefix}forearm_link" />
      <child link="${prefix}lower_wrist_link" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="100"
        velocity="5.5851" />
    </joint>
    <link name="${prefix}upper_wrist_link">
      <inertial>
        <origin xyz="0.01243595 0.03284165 -0.04091434" rpy="0 0 0" />
        <mass value="2.0075751" />
        <inertia ixx="0.00557102" ixy="0" ixz="0"
          iyy="0.00557102" iyz="0"
          izz="0.00361364" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find link6_description)/meshes/upper_wrist_link.STL" />
        </geometry>
        <material name="darkgray" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.02579783" rpy="0 0 0" />
        <geometry>
          <sphere radius="${upper_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 -0.06192018" rpy="0 0 0" />
        <geometry>
          <sphere radius="${upper_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.00760242 0.03851649 -0.07210818" rpy="0 0 0" />
        <geometry>
          <sphere radius="${upper_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.01731829 0.07948508 -0.07309098" rpy="0 0 0" />
        <geometry>
          <sphere radius="${upper_wrist_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.06120646 0.0860149 -0.07708402" rpy="0 0 0" />
        <geometry>
          <sphere radius="${upper_wrist_collision_radius}" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_5" type="revolute">
      <origin xyz="${joint_5_xyz}" rpy="${joint_5_rpy}" />
      <parent link="${prefix}lower_wrist_link" />
      <child link="${prefix}upper_wrist_link" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="100"
        velocity="5.5851" />
    </joint>
    <link name="${prefix}wrist_interface_link">
      <inertial>
        <origin xyz="0 0.00050624 -0.00388589" rpy="0 0 0" />
        <mass value="1.51926049" />
        <inertia ixx="0.00390762" ixy="-1.13E-06" ixz="1.16E-06"
          iyy="0.00390722" iyz="-2.21E-05" izz="0.0013928" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="file://$(find link6_description)/meshes/wrist_interface_link.STL" />
        </geometry>
        <material name="darkgray" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.02647703" rpy="0 0 0" />
        <geometry>
          <sphere radius="${wrist_interface_collision_radius}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 -0.06063214" rpy="0 0 0" />
        <geometry>
          <sphere radius="${wrist_interface_collision_radius}" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}joint_6" type="revolute">
      <origin xyz="${joint_6_xyz}" rpy="${joint_6_rpy}" />
      <parent link="${prefix}upper_wrist_link" />
      <child link="${prefix}wrist_interface_link" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185307179586" upper="6.283185307179586" effort="100"
        velocity="5.5851" />
    </joint>

    <link name="${prefix}end_effector_link" />
    <joint name="${prefix}end_effector" type="fixed">
      <origin xyz="0 0 -0.092" rpy="3.141592653589793 0 0" />
      <parent link="${prefix}wrist_interface_link" />
      <child link="${prefix}end_effector_link" />
    </joint>
  </xacro:macro>
</robot>
