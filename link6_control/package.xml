<package format="3">
  <name>link6_control</name>
  <version>0.0.0</version>
  <description>Control configuration and launch files for the Link6 robot.</description>
  <maintainer email="elhoussainianas8@gmail.com">Anas Houssaini</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ros2_control</depend>

  <exec_depend>kortex3_hardware</exec_depend>
